{
  "name": "@zynkreatech/module-custom-crm",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "manifest.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "shx cp manifest.json dist/manifest.json",
    "dev": "nodemon",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@zynkreatech/core": "workspace:*",
    "@zynkreatech/sdk": "workspace:*",
    "@zynkreatech/ui": "workspace:*",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@zynkreatech/sdk": "workspace:*",
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "eslint": "^9.9.0",
    "nodemon": "^3.1.0",
    "shx": "^0.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}