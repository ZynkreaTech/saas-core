  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0pnpm",
    "@types/react-dom": "^19.2.0",
    "@zynkreatech/ui": "workspace:*",
    "eslint": "^9.9.0",
    "glob": "^13.0.6",
    "lucide-react": "^1.28.0",
    "nodemon": "^3.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
