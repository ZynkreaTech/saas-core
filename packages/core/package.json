{
  "name": "@zynkreatech/core",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./providers/tenant-provider": {
      "types": "./dist/providers/tenant-provider.d.ts",
      "import": "./dist/providers/tenant-provider.mjs",
      "require": "./dist/providers/tenant-provider.js"
    },
    "./providers/query-provider": {
      "types": "./dist/providers/query-provider.d.ts",
      "import": "./dist/providers/query-provider.mjs",
      "require": "./dist/providers/query-provider.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.50.0",
    "zustand": "^4.5.0",
    "zod": "^3.23.0",
    "react-hook-form": "^7.52.0",
    "@hookform/resolvers": "^3.9.0"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "@eslint/js": "^9.9.0",
    "typescript-eslint": "^8.0.0",
    "@zynkreatech/config": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "@types/react": "^19.2.0"
  }
}